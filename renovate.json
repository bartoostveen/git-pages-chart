{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "automerge": true,
  "packageRules": [
    {
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ],
  "postUpgradeTasks": {
    "commands": [
      "bash .forgejo/scripts/generate-renovate-changelog.sh '{{{toJSON upgrades}}}'"
    ],
    "fileFilters": ["changelog.d/**"],
    "executionMode": "branch"
  }
}
